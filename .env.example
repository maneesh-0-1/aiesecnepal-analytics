# ==============================================================================
# AIESEC OPERATIONAL DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. AIESEC GIS / EXPA API
# Your EXPA GraphQL Bearer Token (found from browser network tab or EXPA API)
AIESEC_ACCESS_TOKEN=your_expa_token_here

# 2. GOOGLE FIREBASE CONFIGURATION
# (Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 3. MAINTENANCE SECURITY (Optional but recommended)
# A random secret password to protect cleanup and sync endpoints
CRON_SECRET=super_secret_cron_token_12345

